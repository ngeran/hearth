{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hearth",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Better Auth trusted origin and the same-origin write guard. Local dev uses
    // the Vite origin; production must match the deployed Worker origin.
    "APP_ORIGIN": "http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hearth-db",
      "database_id": "a44819e3-1493-45bc-b9f5-62e9bf7a21ba",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "hearth-photos"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "hearth-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "hearth-jobs"
      }
    ]
  },
  "triggers": {
    "crons": ["0 9 * * 1"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "hearth-staging",
      "vars": {
        // Replace with the real workers.dev or custom-domain origin after the
        // first `pnpm deploy:staging`.
        "APP_ORIGIN": "https://hearth-staging.example.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hearth-db-staging",
          "database_id": "f52e8350-21ad-469e-96d7-bdb8591d241f",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS",
          "bucket_name": "hearth-photos-staging"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CHAT",
            "class_name": "ChatRoom"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ChatRoom"]
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "JOBS",
            "queue": "hearth-jobs-staging"
          }
        ],
        "consumers": [
          {
            "queue": "hearth-jobs-staging"
          }
        ]
      },
      "triggers": {
        "crons": ["0 9 * * 1"]
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
