{
  "name": "hearth-worker-test",
  "main": "./src/index.ts",
  "vars": {
    "APP_ORIGIN": "https://hearth.test",
    "BETTER_AUTH_SECRET": "hearth-worker-test-secret-not-production",
    "ADMIN_EMAILS": "admin@example.com"
  },
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hearth-db-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ]
}
